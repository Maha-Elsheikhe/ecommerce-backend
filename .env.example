# Copy this file to .env and fill in real values. Never commit .env.
# Placeholders only - do not put real secrets in this file.

# Server port (optional, defaults to 3000)
PORT=5000

# PostgreSQL (Neon) pooled connection string
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Long random string used to sign JWTs, e.g. output of: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# Frontend origin (CORS + links in verification/reset emails)
FRONTEND_URL=http://localhost:3000

# Resend (transactional email)
RESEND_API_KEY=re_your_resend_api_key

# Cloudinary (product images)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
